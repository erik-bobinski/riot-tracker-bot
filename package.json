{
  "name": "riot-tracker-bot",
  "version": "1.0.0",
  "description": "Game-agnostic Discord match reporting bot",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx --env-file=.env.dev --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "admin": "node dist/index.js admin",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "log-watcher": "tsx src/log-watcher/index.ts"
  },
  "type": "module",
  "keywords": [],
  "author": "github.com/erik-bobinski",
  "license": "ISC",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "2.1.220",
    "@effect/platform-node": "4.0.0-beta.101",
    "@effect/sql-sqlite-node": "4.0.0-beta.101",
    "@railway/cli": "5.30.1",
    "dfx": "1.0.15",
    "effect": "4.0.0-beta.101"
  }
}
